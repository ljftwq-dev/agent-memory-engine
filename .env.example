# agent-memory-engine configuration.
# Copy to `.env` and adjust. Every key here maps to an env var prefixed `AME_`.
# Any line left commented uses the built-in default.

# --- Storage ---
# AME_DB_PATH=~/.agent-memory/memory.db

# --- Embedding (default: BGE-m3, local & free) ---
# AME_EMBED_MODEL=BAAI/bge-m3
# AME_EMBED_DIM=1024

# --- LLM summarization (optional, OpenAI-compatible) ---
# Leave both empty to disable summarization (engine still works as pure retrieval).
# Works with Zhipu GLM / OpenAI / Ollama / any OpenAI-compatible endpoint.
# AME_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AME_LLM_API_KEY=<your-llm-key>
# AME_LLM_MODEL=glm-4-flash

# --- Retrieval tuning ---
# AME_RECALL_THRESHOLD=0.9    # distance gate (larger = looser)
# AME_RECALL_POOL=15          # stage-A wide recall count
# AME_ALPHA=0.5               # strength weight in rerank score (0..1)
# AME_MIN_STRENGTH=0.05       # drop memories below this real-time strength
# AME_DEDUP_THRESHOLD=0.45    # distance <= this on store => merge into existing
