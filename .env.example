# agent-memory-engine configuration.
# Copy to `.env` and adjust. Every key here maps to an env var prefixed `AME_`.
# Any line left commented uses the built-in default.

# --- Storage ---
# AME_DB_PATH=~/.agent-memory/memory.db

# --- Embedding (default: BGE-m3, local & free) ---
# AME_EMBED_MODEL=BAAI/bge-m3
# AME_EMBED_DIM=1024

# --- LLM summarization (optional, OpenAI-compatible) ---
# Leave both empty to disable summarization (engine still works as pure retrieval).
# Works with Zhipu GLM / OpenAI / Ollama / any OpenAI-compatible endpoint.
# AME_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AME_LLM_API_KEY=<your-llm-key>
# AME_LLM_MODEL=glm-4-flash

# --- Retrieval tuning ---
# AME_RECALL_THRESHOLD=0.9    # distance gate (larger = looser)
# AME_RECALL_POOL=15          # stage-A wide recall count
# AME_ALPHA=0.5               # strength weight in rerank score (0..1)
# AME_MIN_STRENGTH=0.05       # drop memories below this real-time strength
# AME_DEDUP_THRESHOLD=0.45    # distance <= this on store => merge into existing

# --- Hybrid recall (vector + BM25) ---
# AME_HYBRID_ENABLE=1         # 1 = vector + BM25 fused via RRF, 0 = vector only
# AME_BM25_POOL=15            # stage-A BM25 recall count (hybrid mode)

# --- Cross-encoder precision rerank (optional) ---
# After hybrid fusion, a cross-encoder re-scores (query, candidate) pairs and
# replaces the fused relevance. Classic two-stage IR: cheap wide recall, then
# expensive precise rerank. Off by default; gracefully skipped if the model
# isn't loaded (keeps RRF). Install the [reranker] extra to enable.
# AME_RERANKER_ENABLE=0                 # 1 = enable precision rerank
# AME_RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # multilingual cross-encoder
# AME_RERANKER_POOL=0                   # how many candidates to rerank (0 = all gated)

# --- Automatic backups (protects the memory DB from corruption/loss) ---
# Safe snapshots via SQLite's online backup API, while the server runs.
# AME_BACKUP_ENABLE=1                   # 1 = periodic snapshots
# AME_BACKUP_INTERVAL_HOURS=6           # how often to snapshot
# AME_BACKUP_KEEP=5                     # keep only the newest N backups
